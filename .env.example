NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ALLOWED_ORIGIN=http://localhost:4200
MONGODB_URI=mongodb://127.0.0.1:27017/dental_saas_dev
AUTH_ACCESS_TOKEN_SECRET=dev_access_token_secret_change_me_12345
AUTH_REFRESH_TOKEN_SECRET=dev_refresh_token_secret_change_me_12345
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_JWT_ISSUER=dental-saas-backend
AUTH_JWT_AUDIENCE=dental-saas-client
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_PATH=/api/auth
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_REFRESH_COOKIE_HTTP_ONLY=true
TRUST_PROXY_HOPS=0
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
AUTH_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=100
AUTH_RATE_LIMIT_MAX_ATTEMPTS_PER_ACCOUNT=20
# mock|vllm|groq|gemini|cloudflare
AI_ASSISTANT_PROVIDER=vllm
AI_ASSISTANT_ALLOW_MOCK=false
AI_ASSISTANT_MODEL=qwen/qwen3.8-27b
AI_ASSISTANT_VLLM_BASE_URL=http://127.0.0.1:8000/v1
AI_ASSISTANT_VLLM_API_KEY=
AI_ASSISTANT_GROQ_API_KEY=
AI_ASSISTANT_GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_ASSISTANT_GROQ_MAX_COMPLETION_TOKENS=900
AI_ASSISTANT_GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
AI_ASSISTANT_GEMINI_MODEL=gemini-3.5-flash
# groq|gemini|deepgram|mock
STT_PROVIDER=groq
GROQ_STT_MODEL=whisper-large-v3
DEEPGRAM_STT_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
STT_GEMINI_MODEL=gemini-3.8-flash
STT_TIMEOUT_MS=15000
STT_TOTAL_DEADLINE_MS=40000
STT_MAX_ATTEMPTS_PER_PROVIDER=2
STT_ESCALATION_CONFIDENCE=0.8
STT_RETRY_ON_LOW_QUALITY=true
STT_NO_SPEECH_PROB_THRESHOLD=0.6
STT_LOW_LOGPROB_THRESHOLD=-1
STT_COMPRESSION_RATIO_THRESHOLD=2.4
STT_ENTITY_CORRECTION=false
STT_SEND_PATIENT_NAMES=false
AI_ASSISTANT_TIMEOUT_MS=30000
AI_ASSISTANT_MAX_ACTIONS_PER_MESSAGE=8
AI_ASSISTANT_MAX_PLANNING_ROUNDS=4
AI_ASSISTANT_MAX_INPUT_CHARS=4000
AI_ASSISTANT_CONFIRMATION_TTL_SECONDS=900
AI_ASSISTANT_CREATE_TOOLS_ENABLED=true
AI_ASSISTANT_PLANNER_PROMPT_VERSION=v1
