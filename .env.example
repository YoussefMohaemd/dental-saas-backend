NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ALLOWED_ORIGIN=http://localhost:4200
MONGODB_URI=mongodb://127.0.0.1:27017/dental_saas_dev
AUTH_ACCESS_TOKEN_SECRET=dev_access_token_secret_change_me_12345
AUTH_REFRESH_TOKEN_SECRET=dev_refresh_token_secret_change_me_12345
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_JWT_ISSUER=dental-saas-backend
AUTH_JWT_AUDIENCE=dental-saas-client
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_PATH=/api/auth
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_REFRESH_COOKIE_HTTP_ONLY=true
TRUST_PROXY_HOPS=0
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
AUTH_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=100
AUTH_RATE_LIMIT_MAX_ATTEMPTS_PER_ACCOUNT=20
